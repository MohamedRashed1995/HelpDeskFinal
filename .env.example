# Firebase web app configuration (Project settings -> Your apps -> Web app).
# These are public client identifiers, but never commit a filled-in .env file.
# When these are absent the app falls back to the local demo store.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to point Auth/Firestore at the local Firebase emulators.
VITE_FIREBASE_USE_EMULATOR=false
