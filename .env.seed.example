# Copy to .env.seed locally. Never commit the filled-in file.
# Authenticate gcloud/application-default credentials before running the seed script.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

SEED_ORGANIZATION_ID=helpdesk
SEED_PROJECT_ID=helpdesk-core
SEED_REVIEWER_1_EMAIL=reviewer1@company.local
SEED_REVIEWER_1_PASSWORD=use-a-local-secret
SEED_REVIEWER_1_NAME=Reviewer One
SEED_REVIEWER_2_EMAIL=reviewer2@company.local
SEED_REVIEWER_2_PASSWORD=use-a-local-secret
SEED_REVIEWER_2_NAME=Reviewer Two
