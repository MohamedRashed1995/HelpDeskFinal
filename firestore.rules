rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() && profileExists() ? profile().role : 'anonymous';
    }

    function isStaff() {
      return role() in ['reviewer', 'manager'];
    }

    function isManager() {
      return role() == 'manager';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function inProfileScope(data) {
      return data.organizationId == profile().organizationId
        && data.projectId == profile().projectId;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      function unchanged(field) {
        return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
      }

      allow read: if isOwner(uid) || (isStaff() && inProfileScope(resource.data));

      // A profile is created for the caller's own uid; privileged emails receive their configured role.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == (
          (request.auth.token.email == 'manager@helpdesk.com'
            || request.auth.token.email == 'Mohamed.webb@contoso.internal'
            || request.auth.token.email == 'mohamed.webb@contoso.internal') ? 'manager' :
          request.auth.token.email == 'reviewer@helpdesk.com' ? 'reviewer' : 'submitter'
        )
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.organizationId == 'helpdesk'
        && request.resource.data.projectId == 'helpdesk-core';

      // Users may maintain their own profile but never their own role.
      // Only managers promote users to submitter, reviewer, or manager.
      allow update: if (isOwner(uid)
          && unchanged('uid')
          && unchanged('organizationId')
          && unchanged('projectId')
          && unchanged('active')
          && (unchanged('role')
            || ((request.auth.token.email == 'manager@helpdesk.com'
              || request.auth.token.email == 'Mohamed.webb@contoso.internal'
              || request.auth.token.email == 'mohamed.webb@contoso.internal')
              && request.resource.data.role == 'manager')
            || (request.auth.token.email == 'reviewer@helpdesk.com' && request.resource.data.role == 'reviewer')))
        || (isManager()
          && inProfileScope(resource.data)
          && inProfileScope(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && unchanged('role'));

      allow delete: if false;
    }

    // -------------------------------------------------------------- tickets
    match /tickets/{ticketId} {
      function existing() {
        return resource.data;
      }

      function incoming() {
        return request.resource.data;
      }

      function isSubmitterOfTicket() {
        return isSignedIn() && existing().submitterId == request.auth.uid;
      }

      function statusChanged() {
        return incoming().status != existing().status;
      }

      function assigneeChanged() {
        return incoming().assigneeId != existing().assigneeId;
      }

      function priorityChanged() {
        return incoming().priority != existing().priority;
      }

      function inTicketScope(data) {
        return data.organizationId == profile().organizationId
          && data.projectId == profile().projectId;
      }

      function assignmentTargetAllowed() {
        return incoming().assigneeId == null
          || (exists(/databases/$(database)/documents/users/$(incoming().assigneeId))
            && get(/databases/$(database)/documents/users/$(incoming().assigneeId)).data.role == 'reviewer'
            && get(/databases/$(database)/documents/users/$(incoming().assigneeId)).data.active == true
            && inProfileScope(get(/databases/$(database)/documents/users/$(incoming().assigneeId)).data));
      }

      function immutableFieldsKept() {
        return incoming().id == existing().id
          && incoming().submitterId == existing().submitterId
          && incoming().createdAt == existing().createdAt;
      }

      function lifecycleOrdered() {
        return (existing().status == 'Open' && incoming().status == 'In Triage')
          || (existing().status == 'In Triage' && incoming().status == 'In Progress')
          || (existing().status == 'In Progress' && incoming().status == 'Resolved')
          || (existing().status == 'Resolved' && incoming().status == 'Closed');
      }

      // A ticket can never enter In Progress without an assignee.
      function assigneeRequirementMet() {
        return incoming().status != 'In Progress' || incoming().assigneeId != null;
      }

      function statusAllowedForRole() {
        return role() in ['reviewer', 'manager']
          && incoming().status in ['In Triage', 'In Progress', 'Resolved', 'Closed'];
      }

      function assignmentAllowedForRole() {
        return isManager();
      }

      function reviewerUpdateAllowed() {
        return role() == 'reviewer'
          && incoming().status == existing().status
          && incoming().assigneeId == existing().assigneeId
          && incoming().activity.size() > existing().activity.size()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activity', 'updatedAt']);
      }

      function reviewerStatusUpdateAllowed() {
        return role() == 'reviewer'
          && statusChanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'resolvedAt', 'closedAt', 'activity']);
      }

      allow read: if inTicketScope(existing()) && (isStaff() || isSubmitterOfTicket());

      allow create: if isSignedIn()
        && incoming().submitterId == request.auth.uid
        && inTicketScope(incoming())
        && incoming().status == 'Open'
        && incoming().assigneeId == null
        && incoming().id == ticketId
        && incoming().subject is string
        && incoming().description is string;

      allow update: if isSignedIn()
        && isStaff()
        && inTicketScope(existing())
        && inTicketScope(incoming())
        && existing().status != 'Closed'
        && immutableFieldsKept()
        && (role() == 'manager' || reviewerStatusUpdateAllowed() || reviewerUpdateAllowed())
        && (!priorityChanged() || role() == 'manager')
        && (!assigneeChanged() || (role() == 'manager' && assignmentTargetAllowed()))
        && (!statusChanged() || (lifecycleOrdered() && assigneeRequirementMet() && statusAllowedForRole()))
        && (!assigneeChanged() || assignmentAllowedForRole());

      allow delete: if false;
    }

    // ------------------------------------------------------------ auditLogs
    // Append-only: created by the acting user, never updated or deleted by clients.
    match /auditLogs/{logId} {
      allow read: if isStaff()
        && inProfileScope(resource.data)
        || (isSignedIn()
          && resource.data.actorId == request.auth.uid
          && inProfileScope(resource.data));

      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.ticketId is string
        && request.resource.data.action is string
        && request.resource.data.createdAt is string
        && request.resource.data.organizationId == profile().organizationId
        && request.resource.data.projectId == profile().projectId
        && inProfileScope(getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ticketId)).data);

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
